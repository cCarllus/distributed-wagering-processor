{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:built": "bun dist/main.js",
    "worker": "bun src/workers/main.ts",
    "migrate:up": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "queues": "bun scripts/queues.ts",
    "lint": "biome check src tests scripts frontend",
    "format": "biome check --write src tests scripts frontend",
    "check:docs": "bun scripts/check-docs.ts",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json",
    "build": "bun run build:server && bun run build:web",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration --timeout 120000",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "bun scripts/build-web.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.922.0",
    "@mikro-orm/core": "6.6.8",
    "@mikro-orm/migrations": "6.6.8",
    "@mikro-orm/postgresql": "6.6.8",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "prom-client": "15.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "1.3.5",
    "@types/express": "5.0.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
